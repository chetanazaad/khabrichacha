# NOTE: anchored to repo root on purpose -- this must NOT match
# deployment/workspace/ (the source package), only the runtime data
# folder created at startup. An earlier unanchored "workspace/" rule
# silently excluded the whole deployment/workspace/ package from git.
/workspace/
